                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title3"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Care and Maintenance</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 3 - <!--content(text)--><fo:inline>Care and Maintenance</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 3 - <!--content(text)--><fo:inline>Care and Maintenance</fo:inline></fo:marker><fo:inline>Chapter 3. </fo:inline><fo:inline>Care and Maintenance</fo:inline></fo:block></fo:block-container>
                            
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Care and cleaning
                                    instructions for Powerwall 3.</fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container id="d38e1230" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H2"><fo:block end-indent="0" start-indent="0">Environmental
                                        Requirements</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Powerwall 3 is
                                        capable of charging and discharging within the operating
                                        temperature range specified below. At the extremes of the
                                        temperature range, Powerwall 3 may limit charge or discharge
                                        power to improve battery lifespan. </fo:block></fo:block-container>
                                    <fo:block>
                                        <fo:table-and-caption border-collapse="collapse" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" space-before="0.5em" text-align="center"><fo:block end-indent="0" start-indent="0"/></fo:block-container></fo:table-caption><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" hyphenate="true" space-before="0" space-after="0"><fo:table-column/><fo:table-column/><fo:table-body display-align="center">
                                                <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Operating Temperature</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>-20°C to 50°C (-4°F to 122°F)<fo:inline font-size="smaller" vertical-align="super">1</fo:inline></fo:block></fo:table-cell>
                                                </fo:table-row>
                                            </fo:table-body></fo:table></fo:table-and-caption>
                                    </fo:block>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"><fo:inline font-size="smaller" vertical-align="super">1</fo:inline>Powerwall 3 is designed to operate in all
                                        climates and in direct sunlight, from temperatures of -20°C
                                        to 50°C (-4°F to 122°F). Performance may be de-rated at
                                        operating temperatures above 40°C (104°F). </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container id="d38e1276" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H2"><fo:block end-indent="0" start-indent="0">Care
                                        and Cleaning</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Keep the immediate
                                        area around Powerwall 3 clear of foreign objects and debris
                                        to maintain optimal airflow. </fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/caution.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(96 , 96 , 96)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(96 , 96 , 96)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(96 , 96 , 96)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(96 , 96 , 96)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">CAUTION:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Do not lean
                                            on, stack anything on top of, or hang anything from
                                            Powerwall 3 or from wires or conduit leading to
                                            Powerwall 3. </fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/caution.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(96 , 96 , 96)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(96 , 96 , 96)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(96 , 96 , 96)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(96 , 96 , 96)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">CAUTION:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To clean
                                            Powerwall 3, use a soft, lint-free cloth. If needed, the
                                            cloth can be dampened with mild soap and water only.
                                        </fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/caution.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(96 , 96 , 96)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(96 , 96 , 96)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(96 , 96 , 96)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(96 , 96 , 96)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">CAUTION:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Do not use
                                            cleaning solvents to clean Powerwall 3 or expose
                                            Powerwall 3 to flammable or harsh chemicals or vapors.
                                        </fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container id="d38e1315" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H2"><fo:block end-indent="0" start-indent="0">Maintenance</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Powerwall 3 does
                                        not require pre-scheduled preventative maintenance. The only
                                        maintenance required by an owner is to keep the Powerwall
                                        unit free and clear of debris, especially around the air
                                        intake and exhaust. </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                        </fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en"><fo:block-container space-before="1em" role="Sect" id="d132e47"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title4"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>About Powerwall 3</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 4 - <!--content(text)--><fo:inline>About Powerwall 3</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 4 - <!--content(text)--><fo:inline>About Powerwall 3</fo:inline></fo:marker><fo:inline>Chapter 4. </fo:inline><fo:inline>About Powerwall 3</fo:inline></fo:block></fo:block-container>
                            <fo:block role="Sect" id="unique_4" chfox:nd-id="design">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title5"><fo:block end-indent="0" start-indent="0"><fo:inline>System Design</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Powerwall 3 is a
                                        fully integrated solar and battery system that stores energy
                                        from solar production. It converts energy from solar panels
                                        or Solar Roof, and its rechargeable battery pack provides
                                        energy storage for solar self-consumption, load shifting, or
                                        off-grid use. Powerwall 3 is installed with Backup Switch,
                                        Backup Gateway 2, or Gateway 3 to control the system's
                                        connection to the grid and monitor home energy consumption. </fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0"><fo:block-container id="d38e1399" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H3"><fo:block end-indent="0" start-indent="0">Whole
                                            Home Backup System</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">A Powerwall 3
                                            system for whole home backup is designed to store energy
                                            from the grid or solar, and power the entire home during
                                            a grid outage. </fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"><fo:inline font-weight="bold">Whole Home Backup with Backup
                                                Switch</fo:inline></fo:block></fo:block-container>
                                        <fo:inline chfox:inch="true" max-width="100%"><fo:inline><fo:external-graphic src="https://service.tesla.com/docs/Public/Energy/Powerwall/Powerwall-3-Owners-Manual-NA-EN/GUID-D9E74F5A-9475-49E9-8947-E16E2BC7729C-online-en-US.png" max-width="100%" scaling="uniform" width="1024in div 96" content-width="scale-to-fit" height="680in div 96" content-height="scale-to-fit"/></fo:inline></fo:inline>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"><fo:inline font-weight="bold">Whole Home Backup with
                                                Gateway 3 </fo:inline></fo:block></fo:block-container>
                                        <fo:inline chfox:inch="true" max-width="100%"><fo:inline><fo:external-graphic src="https://service.tesla.com/docs/Public/Energy/Powerwall/Powerwall-3-Owners-Manual-NA-EN/GUID-B27EA2BB-8580-40B8-ACEE-35DE5CA7AFDB-online-en-US.png" max-width="100%" scaling="uniform" width="1024in div 96" content-width="scale-to-fit" height="424in div 96" content-height="scale-to-fit"/></fo:inline></fo:inline>
                                    </fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0"><fo:block-container id="d38e1426" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H3"><fo:block end-indent="0" start-indent="0">Partial
                                            Home Backup System</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">A Powerwall 3
                                            system for partial home backup is designed to store
                                            energy from the grid or solar, and can power some home
                                            loads during a grid outage. These loads are selected
                                            during the system design phase, and the installer
                                            configures the system at installation to exclude all
                                            other loads from backup. </fo:block></fo:block-container>
                                        <fo:inline chfox:inch="true" max-width="100%"><fo:inline><fo:external-graphic src="https://service.tesla.com/docs/Public/Energy/Powerwall/Powerwall-3-Owners-Manual-NA-EN/GUID-DB52A678-D30C-44CB-A289-B4DD5FC4A724-online-en-US.png" max-width="100%" scaling="uniform" width="1024in div 96" content-width="scale-to-fit" height="491in div 96" content-height="scale-to-fit"/></fo:inline></fo:inline>
                                    </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="unique_5" chfox:nd-id="components">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title6"><fo:block end-indent="0" start-indent="0"><fo:inline>System Components</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Tables of
                                        components and part numbers.</fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container id="d38e1482" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H3"><fo:block end-indent="0" start-indent="0">Powerwall</fo:block></fo:block-container>
                                        <fo:block>
                                            <fo:table-and-caption border-collapse="collapse" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" space-before="0.5em" text-align="center"><fo:block end-indent="0" start-indent="0"/></fo:block-container></fo:table-caption><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" hyphenate="true" space-before="0" space-after="0"><fo:table-column column-width="16.666666%"/><fo:table-column column-width="33.333332%"/><fo:table-column column-width="50%"/><fo:table-header font-weight="bold" text-align="center" display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_5__entry__1"><fo:block>Component</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_5__entry__2"><fo:block>Descrtiption</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_5__entry__3"><fo:block>Tesla Part Numbers</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                </fo:table-header><fo:table-body display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block><fo:inline chfox:inch="true" max-width="100%" width="400px"><fo:inline><fo:external-graphic src="https://service.tesla.com/docs/Public/Energy/Powerwall/Powerwall-3-Owners-Manual-NA-EN/GUID-81FBBAE3-B1D9-4E6D-98BF-0011F44DB9B8-online-en-US.png" max-width="100%" scaling="uniform" width="400px" content-width="scale-to-fit"/></fo:inline></fo:inline></fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" space-before.conditionality="retain"><fo:block end-indent="0" start-indent="0"><fo:inline font-weight="bold">Powerwall 3</fo:inline> is an integrated solar and
                                                  battery system that converts energy from solar
                                                  panels or Solar Roof to be used by the home, and
                                                  stores excess energy for future use. </fo:block></fo:block-container>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" space-after.conditionality="retain"><fo:block end-indent="0" start-indent="0">Powerwall is installed with one of the following
                                                  Tesla devices.</fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>1707000-xx-y</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                </fo:table-body></fo:table></fo:table-and-caption>
                                        </fo:block>
                                    </fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container id="d38e1548" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H3"><fo:block end-indent="0" start-indent="0">Tesla
                                            Energy Equipment</fo:block></fo:block-container>
                                        <fo:block>
                                            <fo:table-and-caption border-collapse="collapse" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" space-before="0.5em" text-align="center"><fo:block end-indent="0" start-indent="0"/></fo:block-container></fo:table-caption><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" hyphenate="true" space-before="0" space-after="0"><fo:table-column column-width="16.666666%"/><fo:table-column column-width="33.333332%"/><fo:table-column column-width="50%"/><fo:table-header font-weight="bold" text-align="center" display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_5__entry__7"><fo:block>Component</fo:block></fo:table-cell>
