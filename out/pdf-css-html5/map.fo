rtitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en"><fo:block-container space-before="1em" role="Sect" id="unique_7" chfox:nd-id="about"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title8"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>About Powerwall 3</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 5 - <!--content(text)--><fo:inline>About Powerwall 3</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 5 - <!--content(text)--><fo:inline>About Powerwall 3</fo:inline></fo:marker><fo:inline>Chapter 5. </fo:inline><fo:inline>About Powerwall 3</fo:inline></fo:block></fo:block-container>
                            
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This is a landing
                                    page for several subtopics about system operations and
                                    troubleshooting.</fo:block></fo:block-container>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Powerwall systems provide control and monitoring capability
                                    through the Tesla app. During normal operation, Powerwall 3
                                    communicates with Backup Gateway 2, Gateway 3, or Backup Switch,
                                    and the Powerwall 3 On/Off switch should remain in the ON
                                    position. When troubleshooting Powerwall 3 operation, it may be
                                    necessary to turn off Powerwall 3 or refer to its LED indicator
                                    to confirm that it is operating properly. </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_7_Connect_42_general" chfox:nd-id="general"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Do not operate
                                            Powerwall 3 unless all covers are in place. </fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Do not
                                            disconnect anything from or add anything to Powerwall 3.
                                        </fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Do not try to
                                            communicate with Powerwall 3 using third party tools or
                                            diagnostics between Powerwall and the Backup Gateway 2,
                                            Gateway 3, or Backup Switch. </fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                            <fo:block role="Sect" id="unique_8" chfox:nd-id="monitoring">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title9"><fo:block end-indent="0" start-indent="0"><fo:inline>Monitoring Your System</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Monitor
                                        Powerwall 3 system operation from your mobile device using
                                        the Tesla app.</fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The Tesla app
                                            allows you to monitor the following from your mobile
                                            device:</fo:block></fo:block-container>
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Real-time power usage</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Energy
                                                consumption history</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Relative amounts of energy used from solar, grid,
                                                and Powerwall storage</fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block>
                                    </fo:block></fo:block-container>
                                    <fo:block role="Sect">
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Download the latest version
                                                  of the Tesla app from <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://tesla.com/support/tesla-app" fox:alt-text="tesla.com/support/tesla-app">tesla.com/support/tesla-app</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://tesla.com/support/tesla-app" fox:alt-text=" "><fo:inline font-style="italic"/></fo:basic-link></fo:inline>.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Open the Tesla app on your
                                                  mobile device and sign in to your Tesla
                                                  account.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                <fo:inline>Select your Powerwall system
                                                  from the home screen to view system
                                                  operation.</fo:inline>
                                                <fo:block>The app displays real-time
                                                  power usage, energy consumption history, and
                                                  relative amounts of energy used from solar, grid,
                                                  and Powerwall storage.</fo:block>
                                            </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block>
                                    </fo:block>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="unique_9" chfox:nd-id="backup-troubleshooting">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title10"><fo:block end-indent="0" start-indent="0"><fo:inline>Backup Troubleshooting</fo:inline></fo:block></fo:block-container>
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Diagnose and
                                        resolve issues with Powerwall 3 backup operation.</fo:block></fo:block-container>
                                    <fo:block role="Sect">
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                <fo:inline>If a brownout or blackout is
                                                  experienced during backup operation, reduce the
                                                  loads and check that the load breakers have not
                                                  opened.</fo:inline>
                                                <fo:block>
                                                  <fo:block-container background-color="rgba(0 , 120 , 160 , 0.09)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/note.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(0 , 120 , 160)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(0 , 120 , 160)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(0 , 120 , 160)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(0 , 120 , 160)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-weight="700">Note:</fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">See <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://www.tesla.com/support/energy/powerwall/own/best-practices-during-power-outages" fox:alt-text="tesla.com/support/energy/powerwall/own/best-practices-during-power-outages">tesla.com/support/energy/powerwall/own/best-practices-during-power-outages</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://www.tesla.com/support/energy/powerwall/own/best-practices-during-power-outages" fox:alt-text=" "><fo:inline font-style="italic"/></fo:basic-link></fo:inline>
                                                  for best practices to extend the backup duration
                                                  of your system during an outage.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                </fo:block>
                                            </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                <fo:inline>If it is necessary to restart
                                                  the Backup Gateway 2, Gateway 3, or Backup Switch,
                                                  press the Reset button on the device when directed
                                                  to do so by Tesla Support.</fo:inline>
                                                <fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  Reset button and manual override switch are
                                                  located on the Backup Gateway 2, Gateway 3, or
                                                  Backup Switch. The Backup Switch conduit hub must
                                                  be removed to access the Reset button or manual
                                                  override switch.</fo:block></fo:block-container>
                                                  <fo:block>
                                                  <fo:table-and-caption border-collapse="collapse" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" space-before="0.5em" text-align="center"><fo:block end-indent="0" start-indent="0"/></fo:block-container></fo:table-caption><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" hyphenate="true" space-before="0" space-after="0"><fo:table-column column-width="25%"/><fo:table-column column-width="75%"/><fo:table-header font-weight="bold" text-align="center" display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_9__entry__1"><fo:block>Component</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_9__entry__2"><fo:block>Name</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  </fo:table-header><fo:table-body display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>1</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Backup Gateway 2 / Gateway 3 / Backup Switch
                                                  RESET button</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>2</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Backup Gateway 2 / Backup Switch manual override
                                                  switch</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>3</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Backup Gateway 2 / Gateway 3 circuit breaker (in
                                                  most whole-home backup systems)</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>4</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Backup Switch conduit hub</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  </fo:table-body></fo:table></fo:table-and-caption>
                                                  </fo:block>
                                                  <fo:inline chfox:inch="true" max-width="100%"><fo:inline><fo:external-graphic src="https://service.tesla.com/docs/Public/Energy/Powerwall/Powerwall-3-Owners-Manual-NA-EN/GUID-90DC7C1F-642E-4748-91AC-DF15B5D868AC-online-en-US.png" max-width="100%" scaling="uniform" width="1024in div 96" content-width="scale-to-fit" height="397in div 96" content-height="scale-to-fit"/></fo:inline></fo:inline>
                                                  <fo:block-container background-color="rgba(0 , 120 , 160 , 0.09)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/note.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(0 , 120 , 160)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(0 , 120 , 160)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(0 , 120 , 160)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(0 , 120 , 160)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-weight="700">Note:</fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To
                                                  remove the Backup Switch conduit hub, use a
                                                  Phillips PH2 screwdriver to loosen the three
                                                  captured fasteners holding it in place, then
                                                  remove the hub. Once service actions are complete,
                                                  replace the conduit hub and tighten the three
                                                  fasteners.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                </fo:block>
                                            </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                <fo:inline>If it is necessary to
                                                  manually reconnect to the grid, operate the manual
                                                  override switch on the Backup Gateway 2 or Backup
                                                  Switch when directed to do so by Tesla
                                                  Support.</fo:inline>
                                                <fo:block>
                                                  <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Improper
                                                  operation of the manual override switch may damage
                                                  the unit and could void the product warranty. Do
                                                  not remove the conduit hub or operate the manual
                                                  override switch unless directed to do so by Tesla
                                                  Support, or in the event that the grid is present
                                                  but you are experiencing an outage. Contact Tesla
                                                  Support if you are not sure whether you should
                                                  operate the manual override switch.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                  <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Do not
                                                  make any modifications or adjustments to the
                                                  Utility Meter. Only interact with the Backup
                                                  Switch.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                </fo:block>
                                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="0em" space-before="0em">
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">a. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>Push the Backup Switch manual
                                                  override switch in to manually connect the system
                                                  to the grid.</fo:inline>
                                                  <fo:block>
                                                  <fo:inline chfox:inch="true" max-width="100%"><fo:inline><fo:external-graphic src="https://service.tesla.com/docs/Public/Energy/Powerwall/Powerwall-3-Owners-Manual-NA-EN/GUID-A615CF4C-9077-4BC6-8361-FB26C2306EE0-online-en-US.png" max-width="100%" scaling="uniform" width="1024in div 96" content-width="scale-to-fit" height="591in div 96" content-height="scale-to-fit"/></fo:inline></fo:inline>
                                                  </fo:block>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                </fo:list-block>
                                            </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                <fo:inline>To check the Backup Switch
                                                  LED status, remove the conduit hub as described
                                                  above and locate the LED near the Reset
                                                  button.</fo:inline>
                                                <fo:block>
                                                  <fo:block>
                                                  <fo:table-and-caption border-collapse="collapse" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" space-before="0.5em" text-align="center"><fo:block end-indent="0" start-indent="0"/></fo:block-container></fo:table-caption><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" hyphenate="true" space-before="0" space-after="0"><fo:table-column column-width="33.333332%"/><fo:table-column column-width="66.666664%"/><fo:table-header font-weight="bold" text-align="center" display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_9__entry__11"><fo:block>LED State</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_9__entry__12"><fo:block>Indication</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  </fo:table-header><fo:table-body display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>On (solid)</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Power is on, communication established with
                                                  Powerwall</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>On (flashing)</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Power is on, no communication with Powerwall</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Off</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Power is off</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  </fo:table-body></fo:table></fo:table-and-caption>
                                                  </fo:block>
                                                </fo:block>
                                            </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block>
                                    </fo:block>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">If the issue
                                            persists after completing these steps, contact Tesla
                                            Support at <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://tesla.com/support/energy/more/additional-support/contact-us" fox:alt-text="tesla.com/support/energy/more/additional-support/contact-us">tesla.com/support/energy/more/additional-support/contact-us</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://tesla.com/support/energy/more/additional-support/contact-us" fox:alt-text=" "><fo:inline font-style="italic"/></fo:basic-link></fo:inline>.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block role="Sect" id="unique_10" chfox:nd-id="turn_off">
                                    <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H3" id="ariaid-title11"><fo:block end-indent="0" start-indent="0"><fo:inline>Turning the System Off</fo:inline></fo:block></fo:block-container>
                                    <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">If Powerwall
                                            3 is unresponsive, it may be necessary to turn off or
                                            power cycle the system. Note that power cycling the
                                            system must be done in the proper sequence as defined
                                            below. </fo:block></fo:block-container>
                                        <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0"><fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block> On Powerwall 3 systems with
                                                additional interconnected solar, always turn off the
                                                solar inverter(s) or disconnect the solar source(s)
                                                before turning off Powerwall 3. </fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
                                        <fo:block role="Sect">
                                            <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Turn off Powerwall 3 by
                                                  setting its On/Off switch to the OFF position.
                                                  </fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Turn off the AC breaker to
                                                  Powerwall 3. </fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Turn off the AC breaker to
                                                  the Gateway, if installed (for whole-home backup
                                                  systems, this may be a breaker inside the
                                                  Gateway). </fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Wait for at least one hour.
                                                  </fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">5. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Turn the AC breakers back on.
                                                  </fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">6. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Turn on Powerwall 3. </fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                            </fo:list-block>
                                        </fo:block>
                                    </fo:block></fo:block-container>
                                </fo:block>
                                <fo:block role="Sect" id="unique_11" chfox:nd-id="backup">
                                    <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H3" id="ariaid-title12"><fo:block end-indent="0" start-indent="0"><fo:inline>Troubleshooting</fo:inline></fo:block></fo:block-container>
                                    <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">If the
                                            system is not working correctly, perform the following
                                            steps. </fo:block></fo:block-container>
                                        <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/caution.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(96 , 96 , 96)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(96 , 96 , 96)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(96 , 96 , 96)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(96 , 96 , 96)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0"><fo:block page-break-after="avoid" font-weight="700">CAUTION:</fo:block> Powerwall 3
                                            , Backup Gateway 2, Gateway 3, and Backup Switch are not
                                            user-serviceable and must be repaired by Tesla or a
                                            Certified Installer. </fo:block></fo:block-container>
                                        <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0"><fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block> Do not open
                                            the deadfront cover inside the Gateway. Exposed wiring
                                            can present a risk of electrical shock. </fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Check the LED
                                            indicator on Powerwall 3 to determine its status: </fo:block></fo:block-container>
                                        <fo:block>
                                            <fo:table-and-caption border-collapse="collapse" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" space-before="0.5em" text-align="center"><fo:block end-indent="0" start-indent="0"/></fo:block-container></fo:table-caption><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" hyphenate="true" space-before="0" space-after="0"><fo:table-column column-width="33.333332%"/><fo:table-column column-width="66.666664%"/><fo:table-header font-weight="bold" text-align="center" display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_11__entry__1"><fo:block>LED State</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_11__entry__2"><fo:block>Indication</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                </fo:table-header><fo:table-body display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Solid white</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Normal operation </fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Flashing white</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Powerwall 3 is idle. Will enter sleep state if no
                                                  actions in progress </fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Off</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Powerwall 3 is off or in sleep state </fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Flashing red</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Inverter fault </fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                </fo:table-body></fo:table></fo:table-and-caption>
                                        </fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">If it is not
                                            possible to communicate with the system through the
                                            Tesla app, ensure that the home Internet connection is
                                            working. If the home Internet connection is working and
                                            communication through the Tesla app is still not
                                            possible, see <fo:inline>tesla.com/support/energy/powerwall/mobile-app/connecting-powerwall-wi-fi</fo:inline>
                                            for instructions to update your Wi-Fi connection. </fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"><fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text="If Powerwall 3 is unresponsive, it may be necessary to turn off or power cycle the system. Note that power cycling the system must be done in the proper sequence as defined below." internal-destination="unique_10">Turning the System
                                                Off</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text="If Powerwall 3 is unresponsive, it may be necessary to turn off or power cycle the system. Note that power cycling the system must be done in the proper sequence as defined below." internal-destination="unique_10"><fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_10"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_10"><fo:page-number-citation ref-id="unique_10"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_10">)</fo:basic-link></fo:inline></fo:basic-link></fo:inline>If
                                            Powerwall 3 is unresponsive, it may be necessary to turn
                                            off or power cycle the system. Note that power cycling
                                            the system must be done in the proper sequence as
                                            defined below.</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"><fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text="Diagnose and resolve issues with Powerwall 3 backup operation." internal-destination="unique_9">Backup
                                                Troubleshooting</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text="Diagnose and resolve issues with Powerwall 3 backup operation." internal-destination="unique_9"><fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_9"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_9"><fo:page-number-citation ref-id="unique_9"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_9">)</fo:basic-link></fo:inline></fo:basic-link></fo:inline></fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block>
                            </fo:block>
                            <fo:block role="Sect" id="unique_12" chfox:nd-id="support">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title13"><fo:block end-indent="0" start-indent="0"><fo:inline>Technical Support</fo:inline></fo:block></fo:block-container>
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Steps regarding
                                        how to contact the Support team.</fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">If you need
                                            further assistance, contact the Tesla Support team via
                                            the Contact Us page: </fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"><fo:inline>tesla.com/support/energy/more/additional-support/contact-us</fo:inline></fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Have the
                                            following information available when contacting Tesla:
                                        </fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block role="Sect">
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Owner name </fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Best way for Tesla to contact
                                                  you (name, phone number, email) </fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Powerwall 3 and Backup
                                                  Gateway 2 / Gateway 3 / Backup Switch serial
                                                  numbers (see <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text="The serial numbers for your system can be found on their product labels." internal-destination="unique_13">System
                                                  Information</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text="The serial numbers for your system can be found on their product labels." internal-destination="unique_13"><fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_13"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_13"><fo:page-number-citation ref-id="unique_13"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_13">)</fo:basic-link></fo:inline></fo:basic-link></fo:inline>)
                                                </fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Brief description of the
                                                  issue </fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block>
                                    </fo:block>
                                </fo:block></fo:block-container>
                            </fo:block>
                        </fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en"><fo:block-container space-before="1em" role="Sect" id="unique_7_ssol1" chfox:nd-id="about"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title14"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>About Powerwall 3</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 6 - <!--content(text)--><fo:inline>About Powerwall 3</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 6 - <!--content(text)--><fo:inline>About Powerwall 3</fo:inline></fo:marker><fo:inline>Chapter 6. </fo:inline><fo:inline>About Powerwall 3</fo:inline></fo:block></fo:block-container>
                            
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This is a landing
                                    page for several subtopics about system operations and
                                    troubleshooting.</fo:block></fo:block-container>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Powerwall systems provide control and monitoring capability
                                    through the Tesla app. During normal operation, Powerwall 3
                                    communicates with Backup Gateway 2, Gateway 3, or Backup Switch,
                                    and the Powerwall 3 On/Off switch should remain in the ON
                                    position. When troubleshooting Powerwall 3 operation, it may be
                                    necessary to turn off Powerwall 3 or refer to its LED indicator
                                    to confirm that it is operating properly. </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_7_ssol1_Connect_42_general"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Do not operate
                                            Powerwall 3 unless all covers are in place. </fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Do not
                                            disconnect anything from or add anything to Powerwall 3.
                                        </fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Do not try to
                                            communicate with Powerwall 3 using third party tools or
                                            diagnostics between Powerwall and the Backup Gateway 2,
                                            Gateway 3, or Backup Switch. </fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                            <fo:block role="Sect" id="unique_8_ssol1" chfox:nd-id="monitoring">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title15"><fo:block end-indent="0" start-indent="0"><fo:inline>Monitoring Your System</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Monitor
                                        Powerwall 3 system operation from your mobile device using
                                        the Tesla app.</fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The Tesla app
                                            allows you to monitor the following from your mobile
                                            device:</fo:block></fo:block-container>
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Real-time power usage</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Energy
                                                consumption history</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Relative amounts of energy used from solar, grid,
                                                and Powerwall storage</fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block>
                                    </fo:block></fo:block-container>
                                    <fo:block role="Sect">
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Download the latest version
                                                  of the Tesla app from <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://tesla.com/support/tesla-app" fox:alt-text="tesla.com/support/tesla-app">tesla.com/support/tesla-app</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://tesla.com/support/tesla-app" fox:alt-text=" "><fo:inline font-style="italic"/></fo:basic-link></fo:inline>.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Open the Tesla app on your
                                                  mobile device and sign in to your Tesla
                                                  account.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                <fo:inline>Select your Powerwall system
                                                  from the home screen to view system
                                                  operation.</fo:inline>
                                                <fo:block>The app displays real-time
                                                  power usage, energy consumption history, and
                                                  relative amounts of energy used from solar, grid,
                                                  and Powerwall storage.</fo:block>
                                            </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block>
                                    </fo:block>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="d132e172">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title16"><fo:block end-indent="0" start-indent="0"><fo:inline>Troubleshooting</fo:inline></fo:block></fo:block-container>
                                <fo:block role="Sect" id="unique_10_ssol1" chfox:nd-id="turn_off">
                                    <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H3" id="ariaid-title17"><fo:block end-indent="0" start-indent="0"><fo:inline>Turning the System Off</fo:inline></fo:block></fo:block-container>
                                    <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">If Powerwall
                                            3 is unresponsive, it may be necessary to turn off or
                                            power cycle the system. Note that power cycling the
                                            system must be done in the proper sequence as defined
                                            below. </fo:block></fo:block-container>
                                        <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0"><fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block> On Powerwall 3 systems with
                                                additional interconnected solar, always turn off the
                                                solar inverter(s) or disconnect the solar source(s)
                                                before turning off Powerwall 3. </fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
                                        <fo:block role="Sect">
                                            <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Turn off Powerwall 3 by
                                                  setting its On/Off switch to the OFF position.
                                                  </fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Turn off the AC breaker to
                                                  Powerwall 3. </fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Turn off the AC breaker to
                                                  the Gateway, if installed (for whole-home backup
                                                  systems, this may be a breaker inside the
                                                  Gateway). </fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Wait for at least one hour.
                                                  </fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">5. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Turn the AC breakers back on.
                                                  </fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">6. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Turn on Powerwall 3. </fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                            </fo:list-block>
                                        </fo:block>
                                    </fo:block></fo:block-container>
                                </fo:block>
                                <fo:block role="Sect" id="unique_9_ssol1" chfox:nd-id="backup-troubleshooting">
                                    <fo:block-container page-break-after="avoid" font-size="1.4em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H3" id="ariaid-title18"><fo:block end-indent="0" start-indent="0"><fo:inline>Backup Troubleshooting</fo:inline></fo:block></fo:block-container>
                                    <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Diagnose and
                                            resolve issues with Powerwall 3 backup operation.</fo:block></fo:block-container>
                                        <fo:block role="Sect">
                                            <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                                <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>If a brownout or blackout is
                                                  experienced during backup operation, reduce the
                                                  loads and check that the load breakers have not
                                                  opened.</fo:inline>
                                                  <fo:block>
                                                  <fo:block-container background-color="rgba(0 , 120 , 160 , 0.09)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/note.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(0 , 120 , 160)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(0 , 120 , 160)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(0 , 120 , 160)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(0 , 120 , 160)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-weight="700">Note:</fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">See <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://www.tesla.com/support/energy/powerwall/own/best-practices-during-power-outages" fox:alt-text="tesla.com/support/energy/powerwall/own/best-practices-during-power-outages">tesla.com/support/energy/powerwall/own/best-practices-during-power-outages</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://www.tesla.com/support/energy/powerwall/own/best-practices-during-power-outages" fox:alt-text=" "><fo:inline font-style="italic"/></fo:basic-link></fo:inline>
                                                  for best practices to extend the backup duration
                                                  of your system during an outage.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                  </fo:block>
                                                </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>If it is necessary to restart
                                                  the Backup Gateway 2, Gateway 3, or Backup Switch,
                                                  press the Reset button on the device when directed
                                                  to do so by Tesla Support.</fo:inline>
                                                  <fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The
                                                  Reset button and manual override switch are
                                                  located on the Backup Gateway 2, Gateway 3, or
                                                  Backup Switch. The Backup Switch conduit hub must
                                                  be removed to access the Reset button or manual
                                                  override switch.</fo:block></fo:block-container>
                                                  <fo:block>
                                                  <fo:table-and-caption border-collapse="collapse" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" space-before="0.5em" text-align="center"><fo:block end-indent="0" start-indent="0"/></fo:block-container></fo:table-caption><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" hyphenate="true" space-before="0" space-after="0"><fo:table-column column-width="25%"/><fo:table-column column-width="75%"/><fo:table-header font-weight="bold" text-align="center" display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_9_ssol1__entry__1"><fo:block>Component</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_9_ssol1__entry__2"><fo:block>Name</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  </fo:table-header><fo:table-body display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>1</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Backup Gateway 2 / Gateway 3 / Backup Switch
                                                  RESET button</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>2</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Backup Gateway 2 / Backup Switch manual override
                                                  switch</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>3</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Backup Gateway 2 / Gateway 3 circuit breaker (in
                                                  most whole-home backup systems)</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>4</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Backup Switch conduit hub</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  </fo:table-body></fo:table></fo:table-and-caption>
                                                  </fo:block>
                                                  <fo:inline chfox:inch="true" max-width="100%"><fo:inline><fo:external-graphic src="https://service.tesla.com/docs/Public/Energy/Powerwall/Powerwall-3-Owners-Manual-NA-EN/GUID-90DC7C1F-642E-4748-91AC-DF15B5D868AC-online-en-US.png" max-width="100%" scaling="uniform" width="1024in div 96" content-width="scale-to-fit" height="397in div 96" content-height="scale-to-fit"/></fo:inline></fo:inline>
                                                  <fo:block-container background-color="rgba(0 , 120 , 160 , 0.09)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/note.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(0 , 120 , 160)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(0 , 120 , 160)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(0 , 120 , 160)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(0 , 120 , 160)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-weight="700">Note:</fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To
                                                  remove the Backup Switch conduit hub, use a
                                                  Phillips PH2 screwdriver to loosen the three
                                                  captured fasteners holding it in place, then
                                                  remove the hub. Once service actions are complete,
                                                  replace the conduit hub and tighten the three
                                                  fasteners.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                  </fo:block>
                                                </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>If it is necessary to
                                                  manually reconnect to the grid, operate the manual
                                                  override switch on the Backup Gateway 2 or Backup
                                                  Switch when directed to do so by Tesla
                                                  Support.</fo:inline>
                                                  <fo:block>
                                                  <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Improper
                                                  operation of the manual override switch may damage
                                                  the unit and could void the product warranty. Do
                                                  not remove the conduit hub or operate the manual
                                                  override switch unless directed to do so by Tesla
                                                  Support, or in the event that the grid is present
                                                  but you are experiencing an outage. Contact Tesla
                                                  Support if you are not sure whether you should
                                                  operate the manual override switch.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                  <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Do not
                                                  make any modifications or adjustments to the
                                                  Utility Meter. Only interact with the Backup
                                                  Switch.</fo:block></fo:block-container>
                                                  </fo:block></fo:block-container>
                                                  </fo:block>
                                                  <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="0em" space-before="0em">
                                                  <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">a. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>Push the Backup Switch manual
                                                  override switch in to manually connect the system
                                                  to the grid.</fo:inline>
                                                  <fo:block>
                                                  <fo:inline chfox:inch="true" max-width="100%"><fo:inline><fo:external-graphic src="https://service.tesla.com/docs/Public/Energy/Powerwall/Powerwall-3-Owners-Manual-NA-EN/GUID-A615CF4C-9077-4BC6-8361-FB26C2306EE0-online-en-US.png" max-width="100%" scaling="uniform" width="1024in div 96" content-width="scale-to-fit" height="591in div 96" content-height="scale-to-fit"/></fo:inline></fo:inline>
                                                  </fo:block>
                                                  </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                  </fo:list-block>
                                                </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                  <fo:inline>To check the Backup Switch
                                                  LED status, remove the conduit hub as described
                                                  above and locate the LED near the Reset
                                                  button.</fo:inline>
                                                  <fo:block>
                                                  <fo:block>
                                                  <fo:table-and-caption border-collapse="collapse" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" space-before="0.5em" text-align="center"><fo:block end-indent="0" start-indent="0"/></fo:block-container></fo:table-caption><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" hyphenate="true" space-before="0" space-after="0"><fo:table-column column-width="33.333332%"/><fo:table-column column-width="66.666664%"/><fo:table-header font-weight="bold" text-align="center" display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_9_ssol1__entry__11"><fo:block>LED State</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_9_ssol1__entry__12"><fo:block>Indication</fo:block></fo:table-cell>
