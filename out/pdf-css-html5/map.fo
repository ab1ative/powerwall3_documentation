                                    </fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(0 , 120 , 160 , 0.09)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/note.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(0 , 120 , 160)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(0 , 120 , 160)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(0 , 120 , 160)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(0 , 120 , 160)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
