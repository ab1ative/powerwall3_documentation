                        </fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en"><fo:block-container space-before="1em" role="Sect" id="unique_14" chfox:nd-id="emergency"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title20"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>What to Do in Case of an Emergency</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 7 - <!--content(text)--><fo:inline>What to Do in Case of an Emergency</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 7 - <!--content(text)--><fo:inline>What to Do in Case of an Emergency</fo:inline></fo:marker><fo:inline>Chapter 7. </fo:inline><fo:inline>What to Do in Case of an
                                Emergency</fo:inline></fo:block></fo:block-container>
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Steps to take in the
                                    event of a fire, flooding, unusual smell or smoke, or unusual
                                    noises from Powerwall 3.</fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">In the event of
                                        any threat to health or safety, always complete the
                                        following two steps before addressing the scenario-specific
                                        steps below:</fo:block></fo:block-container>
                                    <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Immediately contact the fire department or other
                                            relevant emergency response team.</fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Notify all
                                            people who might be affected and ensure that they can
                                            evacuate the area.</fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Only perform
                                            the suggested actions below if it is safe to do so.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block role="Sect">
                                    <fo:block>Fire or General Emergency</fo:block>
                                    <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>On Powerwall 3 systems with
                                                additional interconnected solar, turn off the AC
                                                breaker for all solar inverters.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Turn off all Powerwall(s), then
                                                turn off the AC breaker to Powerwall(s).</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Turn off the Powerwall 3
                                                integrated DC isolator.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Turn off the AC breaker to the
                                                Gateway, if installed.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">5. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                            <fo:inline>If using a fire extinguisher,
                                                use only water, CO2, or ABC type
                                                extinguishers.</fo:inline>
                                            <fo:block>
                                                <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                                  <fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Do not
                                                  use type D (flammable metal) extinguishers.</fo:block></fo:block-container>
                                                </fo:block></fo:block-container>
                                            </fo:block>
                                        </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block>
                                    <fo:block>Flooding</fo:block>
                                    <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>6. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Stay out of the water if any
                                                part of the battery, Gateway, or wiring is
                                                submerged.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>7. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>On Powerwall 3 systems with
                                                additional interconnected solar, turn off the AC
                                                breaker for all solar inverters.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>8. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Turn off all Powerwall(s), then
                                                turn off the AC breaker to Powerwall(s).</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>9. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Turn off the Powerwall 3
                                                integrated DC isolator.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>10. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Turn off the AC breaker to the
                                                Gateway, if installed.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>11. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>If possible, find and stop the
                                                source of the water and pump water away from the
                                                system.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>12. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>If any part of the unit was
                                                submerged, note the depth and duration of the
                                                flooding.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>13. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Contact Tesla Support to
                                                determine if the unit can be safely turned back
                                                on.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>14. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>If Tesla Support confirms it is
                                                safe to turn the unit back on, allow the area to dry
                                                completely before use.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block>
                                    <fo:block>Unusual Smell or Smoke</fo:block>
                                    <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>15. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>On Powerwall 3 systems with
                                                additional interconnected solar, turn off the AC
                                                breaker for all solar inverters.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>16. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Turn off all Powerwall(s), then
                                                turn off the AC breaker to Powerwall(s).</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>17. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Turn off the Powerwall 3
                                                integrated DC isolator.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>18. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Turn off the AC breaker to the
                                                Gateway, if installed.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>19. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Ensure nothing is in contact
                                                with Powerwall.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>20. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Ventilate the room.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block>
                                    <fo:block>Unusual Noises</fo:block>
                                    <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>21. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Turn off all Powerwall(s), then
                                                turn off the AC breaker to Powerwall(s).</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>22. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Turn off the Powerwall 3
                                                integrated DC isolator.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>23. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Turn off the AC breaker to the
                                                Gateway, if installed.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end"><fo:block>24. </fo:block></fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Ensure that nothing is blocking
                                                the air intake or exhaust vents on the Powerwall or
                                                in the fan.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block>
                                </fo:block>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">In all cases, once
                                        the situation is stable, contact the Tesla Certified
                                        Installer who installed the system.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For first
                                        responder information, see <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://www.tesla.com/firstresponders" fox:alt-text="tesla.com/firstresponders">tesla.com/firstresponders</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://www.tesla.com/firstresponders" fox:alt-text=" "><fo:inline font-style="italic"/></fo:basic-link></fo:inline>.</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                        </fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" id="last-page-sequence" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker ret