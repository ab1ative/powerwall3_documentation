                                        <fo:block page-break-after="avoid" font-weight="700">CAUTION:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Do not place
                                            Powerwall 3 in a storage condition for more than one
                                            month, or permit the electrical feed to be severed for
                                            more than one month. Contact your installer for more
                                            information if needed.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/caution.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(96 , 96 , 96)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(96 , 96 , 96)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(96 , 96 , 96)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(96 , 96 , 96)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">CAUTION:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Do not paint
                                            any part of Powerwall 3, including any internal or
                                            external components such as the exterior shell or
                                            casing.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/caution.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(96 , 96 , 96)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(96 , 96 , 96)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(96 , 96 , 96)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(96 , 96 , 96)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">CAUTION:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">When
                                            installing Powerwall 3 in a garage or near vehicles,
                                            keep it out of the driving path. If possible, install
                                            Powerwall 3 on a side wall and/or above the height of
                                            vehicle bumpers.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_1_Connect_42_environmental" chfox:nd-id="environmental"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container id="d38e1011" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H2"><fo:block end-indent="0" start-indent="0">Environmental
                                        Conditions</fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/warning.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(255 , 202 , 45)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(255 , 202 , 45)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(255 , 202 , 45)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(255 , 202 , 45)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">Warning:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Install
                                            Powerwall 3 in a location that prevents damage from
                                            flooding.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/caution.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(96 , 96 , 96)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(96 , 96 , 96)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(96 , 96 , 96)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(96 , 96 , 96)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">CAUTION:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Operating or
                                            storing Powerwall 3 in temperatures outside its
                                            specified range might cause damage to Powerwall.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/caution.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(96 , 96 , 96)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(96 , 96 , 96)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(96 , 96 , 96)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(96 , 96 , 96)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">CAUTION:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Ensure that no
                                            water sources are above or near Powerwall 3, including
                                            downspouts, sprinklers, or faucets.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container background-color="rgba(255 , 202 , 45 , 0.1)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/caution.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(96 , 96 , 96)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(96 , 96 , 96)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(96 , 96 , 96)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(96 , 96 , 96)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em"><fo:block end-indent="0" start-indent="0">
                                        <fo:block page-break-after="avoid" font-weight="700">CAUTION:</fo:block>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Ensure that
                                            snow does not accumulate around Powerwall 3.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_1_Connect_42_fcc" chfox:nd-id="fcc"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container id="d38e1057" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H2"><fo:block end-indent="0" start-indent="0">FCC
                                        Compliance</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This device
                                        complies with part 15 of the FCC Rules. Operation is subject
                                        to the following two conditions: (1) this device may not
                                        cause harmful interference, and (2) this device must accept
                                        any interference received, including interference that may
                                        cause undesired operation.</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_1_Connect_42_rf" chfox:nd-id="rf"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container id="d38e1069" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H2"><fo:block end-indent="0" start-indent="0">RF
                                        Exposure Information (MPE)</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This device has
                                        been tested and meets applicable limits for Radio Frequency
                                        (RF) exposure. This equipment should be installed and
                                        operated with minimum distance 20 cm between the radiator
                                        and your body. </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_1_Connect_42_ised" chfox:nd-id="ised"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container id="d38e1081" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H2"><fo:block end-indent="0" start-indent="0">ISED
                                        Canada Compliance Statement</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This device
                                        contains licence-exempt transmitter(s)/receiver(s) that
                                        comply with Innovation, Science and Economic Development
                                        Canada’s licence-exempt RSS(s). Operation is subject to the
                                        following two conditions: (1) this device may not cause
                                        interference, and (2) this device must accept any
                                        interference, including interference that may cause
                                        undesired operation of the device. </fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The device for
                                        operation in the band 5150–5250 MHz is only for indoor use
                                        to reduce the potential for harmful interference to
                                        co-channel mobile satellite systems. </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                        </fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chapte