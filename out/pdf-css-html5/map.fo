                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Power is on, communication established with
                                                  Powerwall</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>On (flashing)</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Power is on, no communication with Powerwall</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Off</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>Power is off</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  </fo:table-body></fo:table></fo:table-and-caption>
                                                  </fo:block>
                                                  </fo:block>
                                                </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                            </fo:list-block>
                                        </fo:block>
                                        <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">If the
                                                issue persists after completing these steps, contact
                                                Tesla Support at <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://tesla.com/support/energy/more/additional-support/contact-us" fox:alt-text="tesla.com/support/energy/more/additional-support/contact-us">tesla.com/support/energy/more/additional-support/contact-us</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" external-destination="https://tesla.com/support/energy/more/additional-support/contact-us" fox:alt-text=" "><fo:inline font-style="italic"/></fo:basic-link></fo:inline>.</fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block>
                            </fo:block>
                            <fo:block role="Sect" id="unique_12_ssol1" chfox:nd-id="support">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title19"><fo:block end-indent="0" start-indent="0"><fo:inline>Technical Support</fo:inline></fo:block></fo:block-container>
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Steps regarding
                                        how to contact the Support team.</fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">If you need
                                            further assistance, contact the Tesla Support team via
                                            the Contact Us page: </fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"><fo:inline>tesla.com/support/energy/more/additional-support/contact-us</fo:inline></fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Have the
                                            following information available when contacting Tesla:
                                        </fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block role="Sect">
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Owner name </fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Best way for Tesla to contact
                                                  you (name, phone number, email) </fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Powerwall 3 and Backup
                                                  Gateway 2 / Gateway 3 / Backup Switch serial
                                                  numbers (see <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text="The serial numbers for your system can be found on their product labels." internal-destination="unique_13">System
                                                  Information</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text="The serial numbers for your system can be found on their product labels." internal-destination="unique_13"><fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_13"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_13"><fo:page-number-citation ref-id="unique_13"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_13">)</fo:basic-link></fo:inline></fo:basic-link></fo:inline>)
